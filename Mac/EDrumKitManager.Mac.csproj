<Project Sdk="Microsoft.NET.Sdk">

  <!-- Mac window (native AppKit, VoiceOver friendly) on top of the shared core in Core/. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <SupportedOSPlatformVersion>14.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EDrumKitManager</AssemblyName>
    <RootNamespace>TD12KitManager.Mac</RootNamespace>
    <Product>E-Drum Kit Manager</Product>
    <Version>1.0.0</Version>
    <ApplicationId>com.edrumkitmanager.app</ApplicationId>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <CFBundleDisplayName>E-Drum Kit Manager</CFBundleDisplayName>
    <!-- The newest macOS workload (27.0.10742) asks for Xcode 27.1 exactly; Xcode 27.2 is installed. Remove this when the workload catches up. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
  </PropertyGroup>

  <ItemGroup>
    <BundleResource Include="UserGuide/User Guide.html" Link="User Guide.html" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Core/TD12KitManager.Core.csproj" />
  </ItemGroup>

</Project>
