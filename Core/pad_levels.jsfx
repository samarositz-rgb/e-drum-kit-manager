slider127:100<25,300,1>-Note 126 (%)
slider128:100<25,300,1>-Note 127 (%)

in_pin:none
out_pin:none

@block
while (midirecv(ofs, m1, m2, m3)) (
  (m1 & 0xF0) == 0x90 && m3 > 0 ? (
    m3 = max(1, min(127, floor(m3 * slider(m2 + 1) / 100 + 0.5)));
  );
  midisend(ofs, m1, m2, m3);
);
